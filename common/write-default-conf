#!/system/bin/sh
# write-default-conf <conf_file>
# Writes the default imgdrive.conf to the given path.
# Sourced or called directly; does NOT check if file exists — caller decides.

_write_conf() {
    dest="$1"
    mkdir -p "$(dirname "$dest")"
    # Derive the config directory so the keyfile defaults to the same location.
    conf_dir="$(dirname "$dest")"
    cat > "$dest" << CONF
# imgdrive configuration
# Defaults use internal storage — works out of the box.
# Change IMAGE_REAL/IMAGE_USB to an SD card path if preferred.
# Run: imgdrive-ctl setup 10G   (or use WebUI → Create Encrypted Drive)

# Path to the image file — internal storage default, no SD card needed.
IMAGE_REAL="/data/media/0/imgdrive/drive.img"

# Same file via emulated storage (used by isodrive for USB export).
IMAGE_USB="/storage/emulated/0/imgdrive/drive.img"

# LUKS keyfile — stored next to this config file.
KEYFILE="${conf_dir}/imgdrive.key"

NAME="drive"
REAL_MOUNT="/mnt/media_rw/drive"
USER_VIEW="/data/media/0/drive"
PUBLIC_VIEW="/storage/emulated/0/drive"
BIND_UID=1023
BIND_GID=1023
BIND_PERMS=0770
AUTO_MOUNT=1
CRYPTSETUP_BIN="/data/data/com.termux/files/usr/bin/cryptsetup"
LOSETUP_BIN="/data/data/com.termux/files/usr/bin/losetup"
BINDFS_BIN="/data/data/com.termux/files/usr/bin/bindfs"
NSENTER_BIN="/data/data/com.termux/files/usr/bin/nsenter"
ISODRIVE_BIN="/system/bin/isodrive"
CONF
}

# If called directly (not sourced), write to the path given as $1.
case "$0" in
    *write-default-conf)
        FORCE=0; DEST=""
        for _a in "$@"; do
            case "$_a" in
                --force|-f) FORCE=1 ;;
                *) DEST="$_a" ;;
            esac
        done
        DEST="${DEST:-/sdcard/Documents/imgdrive/imgdrive.conf}"
        if [ -f "$DEST" ] && [ "$FORCE" -eq 0 ]; then
            printf 'imgdrive: config already exists: %s\nUse --force to overwrite (a .bak copy will be made).\n' "$DEST" >&2
            exit 1
        fi
        if [ -f "$DEST" ] && [ "$FORCE" -eq 1 ]; then
            cp "$DEST" "${DEST}.bak" 2>/dev/null && \
                printf 'imgdrive: backed up existing config to %s.bak\n' "$DEST" >&2
        fi
        _write_conf "$DEST"
        ;;
esac
