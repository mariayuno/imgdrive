#!/system/bin/sh
# imgdrive-ctl
# Two-stage image drive manager.
#
# Usage:    imgdrive-ctl [-v] [-c <conf>] [mount|usb|toggle|sync|status|off]
#
# Config:   /sdcard/Documents/imgdrive/imgdrive.conf  (default)
#           Pass -c /path/to/other.conf for a named drive.

CONF_FILE="/sdcard/Documents/imgdrive/imgdrive.conf"

# ---------------------------------------------------------------------------
# Pre-parse: extract -c/--conf before config is sourced (POSIX sh, no arrays)
# ---------------------------------------------------------------------------
_preparse() {
    _take=0
    for _a in "$@"; do
        if [ "$_take" -eq 1 ]; then CONF_FILE="$_a"; _take=0; continue; fi
        case "$_a" in
            -c|--conf)      _take=1 ;;
            -c=*|--conf=*)  CONF_FILE="${_a#*=}" ;;
        esac
    done
}
_preparse "$@"

# ---------------------------------------------------------------------------
# Defaults (overridden by config)
# ---------------------------------------------------------------------------
IMAGE_REAL=""
IMAGE_USB=""
KEYFILE=""
NAME="drive"
REAL_MOUNT="/mnt/media_rw/drive"
USER_VIEW="/data/media/0/drive"
PUBLIC_VIEW="/storage/emulated/0/drive"
BIND_UID=1023
BIND_GID=1023
BIND_PERMS=0770
CRYPTSETUP_BIN="/data/data/com.termux/files/usr/bin/cryptsetup"
LOSETUP_BIN="/data/data/com.termux/files/usr/bin/losetup"
BINDFS_BIN="/data/data/com.termux/files/usr/bin/bindfs"
NSENTER_BIN="/data/data/com.termux/files/usr/bin/nsenter"
ISODRIVE_BIN="/system/bin/isodrive"

VERBOSE=0
COMMAND=""
STATE="BROKEN"
STATE_REASON=""
LOOP=""

MOUNTINFO=""
LOCAL_MOUNTINFO=""
MAPPER_STATUS=""

ISO=0; MAPPER=0; REAL=0; BIND=0; PUBLIC=0
LOOP_PRESENT=0; LOOP_OK=0; MAPPER_STACK_OK=0
BIND_OK=0; PUBLIC_OK=0; ISO_OK=0

# ---------------------------------------------------------------------------
# Load config (repopulate if missing)
# ---------------------------------------------------------------------------
WRITE_CONF="/data/adb/imgdrive/bin/write-default-conf"

if [ ! -f "$CONF_FILE" ]; then
    printf '%s\n' "[imgdrive] Config not found — attempting to write default: $CONF_FILE"
    if [ -x "$WRITE_CONF" ]; then
        "$WRITE_CONF" "$CONF_FILE" && \
            printf '%s\n' "[imgdrive] Default config written — edit $CONF_FILE then re-run imgdrive-ctl" || \
            printf '%s\n' "[imgdrive] ERROR: Failed to write default config"
    else
        printf '%s\n' "[imgdrive] ERROR: write-default-conf not found at $WRITE_CONF"
    fi
    exit 1
fi
# shellcheck disable=SC1090
. "$CONF_FILE"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
log()   { printf '%s\n' "[imgdrive] $*"; }
debug() { [ "$VERBOSE" -eq 1 ] && printf '%s\n' "[imgdrive] DEBUG: $*"; }
die()   { log "ERROR: $*"; exit 1; }

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=1 ;;
        -q|--quiet)   VERBOSE=0 ;;
        -c|--conf)    shift ;;          # already consumed by _preparse
        -c=*|--conf=*) ;;               # already consumed by _preparse
        mount|usb|toggle|sync|status|off) COMMAND="$1" ;;
        setup)
            COMMAND="setup"; shift; SETUP_SIZE="$1"
            [ -n "$SETUP_SIZE" ] || die "Usage: imgdrive-ctl setup <size>  e.g. 10G or 500M"
            ;;
        keys)
            COMMAND="keys"; shift; KEYS_CMD="${1:-}"
            case "$KEYS_CMD" in
                list)     shift ;;
                add-pass) shift ;;
                add-key)  shift; KEYS_ARG="${1:-}"; [ -n "$KEYS_ARG" ] || die "keys add-key: missing <keyfile-path>"; shift ;;
                remove)   shift; KEYS_ARG="${1:-}"; [ -n "$KEYS_ARG" ] || die "keys remove: missing <slot-number>"; shift ;;
                *) die "Usage: imgdrive-ctl keys <list|add-pass|add-key <path>|remove <slot>>" ;;
            esac ;;
        drives)
            COMMAND="drives"; shift; DRIVES_CMD="${1:-}"
            case "$DRIVES_CMD" in
                list)   shift ;;
                add)    shift; DRIVES_ARG="${1:-}"; [ -n "$DRIVES_ARG" ] || die "drives add: missing <name>"; shift ;;
                remove) shift; DRIVES_ARG="${1:-}"; [ -n "$DRIVES_ARG" ] || die "drives remove: missing <name>"; shift ;;
                *) die "Usage: imgdrive-ctl drives <list|add <name>|remove <name>>" ;;
            esac ;;
        -h|--help)
            cat <<'USAGE'
Usage: imgdrive-ctl [-v] [-q] [-c <conf>] <command>

Mount commands:
  mount           Ensure Stage 1 (local decrypted filesystem)
  usb             Ensure Stage 2 (USB raw image export)
  toggle          Toggle Stage 1 <-> Stage 2
  sync            USB connected => Stage 2, else Stage 1
  status          Show current state (read-only)
  off             Tear everything down

Provisioning:
  setup <size>    Create encrypted drive  (e.g. 10G, 500M)

LUKS key management:
  keys list       Show active key slots (warns if only 1)
  keys add-pass   Add a passphrase slot (reads from stdin)
  keys add-key <path>   Add a keyfile slot (generates file if absent)
  keys remove <slot>    Remove a slot by number

Multi-drive:
  drives list     List all drive configs
  drives add <name>     Create a new drive config in conf.d/
  drives remove <name>  Delete a drive config (image untouched)

Options:
  -c <conf>   Use alternate config file (default: /sdcard/Documents/imgdrive/imgdrive.conf)
  -v          Verbose output
  -q          Quiet

No command defaults to toggle.
USAGE
            exit 0
            ;;
        *) die "Unknown argument: $1" ;;
    esac
    shift
done

COMMAND="${COMMAND:-toggle}"

# ---------------------------------------------------------------------------
# PID 1 / global mount namespace helpers
# ---------------------------------------------------------------------------

g_mountinfo()   { "$NSENTER_BIN" -t 1 -m -- cat /proc/self/mountinfo 2>/dev/null; }
g_mount()       { "$NSENTER_BIN" -t 1 -m -- mount "$@"; }
g_umount()      { "$NSENTER_BIN" -t 1 -m -- umount "$@"; }

refresh_mountinfo() {
    MOUNTINFO="$(g_mountinfo)"
    LOCAL_MOUNTINFO="$(cat /proc/self/mountinfo 2>/dev/null)"
}

mi_entry() {
    target="$1"
    printf '%s\n' "$MOUNTINFO" |
        awk -v t="$target" '
            $5 != t { next }
            { for (i = 7; i <= NF; i++) {
                if ($i == "-") { printf "%s|%s|%s|%s\n", $(i+1), $(i+2), $6, $(i+3); exit }
            } }'
}

mi_entry_local() {
    target="$1"
    printf '%s\n' "$LOCAL_MOUNTINFO" |
        awk -v t="$target" '
            $5 != t { next }
            { for (i = 7; i <= NF; i++) {
                if ($i == "-") { printf "%s|%s|%s|%s\n", $(i+1), $(i+2), $6, $(i+3); exit }
            } }'
}

mi_has_opt()      { case ",$1," in *",$2,"*) return 0;; *) return 1;; esac; }
mi_path_mounted() { [ -n "$(mi_entry "$1")" ]; }

mi_f2fs_ok() {
    target="$1"; source="$2"
    entry="$(mi_entry "$target")"; [ -n "$entry" ] || return 1
    fstype="$(printf '%s\n' "$entry" | cut -d'|' -f1)"
    src="$(printf '%s\n'    "$entry" | cut -d'|' -f2)"
    opts="$(printf '%s\n'   "$entry" | cut -d'|' -f3)"
    [ "$fstype" = "f2fs" ] && [ "$src" = "$source" ] && mi_has_opt "$opts" rw
}

mi_bindfs_source_ok() {
    target="$1"; source="$2"
    entry="$(mi_entry "$target")"; [ -n "$entry" ] || return 1
    fstype="$(printf '%s\n' "$entry" | cut -d'|' -f1)"
    src="$(printf '%s\n'    "$entry" | cut -d'|' -f2)"
    opts="$(printf '%s\n'   "$entry" | cut -d'|' -f3)"
    [ "$fstype" = "fuse.bindfs" ] && [ "$src" = "$source" ] && mi_has_opt "$opts" rw
}

mi_bindfs_source_ok_local() {
    target="$1"; source="$2"
    entry="$(mi_entry_local "$target")"; [ -n "$entry" ] || return 1
    fstype="$(printf '%s\n' "$entry" | cut -d'|' -f1)"
    src="$(printf '%s\n'    "$entry" | cut -d'|' -f2)"
    opts="$(printf '%s\n'   "$entry" | cut -d'|' -f3)"
    [ "$fstype" = "fuse.bindfs" ] && [ "$src" = "$source" ] && mi_has_opt "$opts" rw
}

g_real_f2fs_present() { mi_f2fs_ok "$REAL_MOUNT" "/dev/mapper/$NAME"; }

g_bind_mounts() {
    printf '%s\n' "$MOUNTINFO" |
        awk -v src="$REAL_MOUNT" '
            { for (i = 7; i <= NF; i++) {
                if ($i == "-") {
                    if ($(i+1) == "fuse.bindfs" && $(i+2) == src) print $5
                    break
                }
            } }'
}

g_bindfs_present() { [ -n "$(g_bind_mounts)" ]; }

# ---------------------------------------------------------------------------
# Image / crypt / loop helpers
# ---------------------------------------------------------------------------

image_path_match() {
    case "$1" in
        "$IMAGE_REAL"|"$IMAGE_USB"|"/data/media/0/ext/sdcard/$(basename "$IMAGE_REAL")")
            return 0 ;;
        *) return 1 ;;
    esac
}

mapper_status()          { "$CRYPTSETUP_BIN" status "$NAME" 2>/dev/null; }
mapper_active()          { mapper_status | grep -q ' is active\.$'; }
mapper_device_present()  { [ -b "/dev/mapper/$NAME" ]; }

mapper_status_consistent() {
    status="$MAPPER_STATUS"; [ -n "$status" ] || return 1
    printf '%s\n' "$status" | grep -q ' is active\.$' || return 1
    loop="$(    printf '%s\n' "$status" | awk '$1=="device:"{print $2;exit}')"
    backing="$( printf '%s\n' "$status" | awk '$1=="loop:"  {print $2;exit}')"
    type="$(    printf '%s\n' "$status" | awk '$1=="type:"  {print $2;exit}')"
    mode="$(    printf '%s\n' "$status" | awk '$1=="mode:"  {print $2;exit}')"
    [ -b "$loop" ] && [ "$backing" = "$IMAGE_REAL" ] && [ "$type" = "LUKS2" ] && [ "$mode" = "read/write" ]
}

mapper_loop_from_status()    { printf '%s\n' "$MAPPER_STATUS" | awk '$1=="device:"{print $2;exit}'; }
mapper_backing_from_status() { printf '%s\n' "$MAPPER_STATUS" | awk '$1=="loop:"  {print $2;exit}'; }

loop_backing()        { cat "/sys/block/$(basename "$1")/loop/backing_file"         2>/dev/null; }
loop_ro()             { cat "/sys/block/$(basename "$1")/ro"                        2>/dev/null; }
loop_dio()            { cat "/sys/block/$(basename "$1")/loop/dio"                  2>/dev/null; }
loop_logical_sector() { cat "/sys/block/$(basename "$1")/queue/logical_block_size"  2>/dev/null; }

loop_config_ok() {
    loop="$1"; [ -b "$loop" ] || return 1
    [ "$(loop_backing        "$loop")" = "$IMAGE_REAL" ] || return 1
    [ "$(loop_logical_sector "$loop")" = "4096" ]        || return 1
    [ "$(loop_dio            "$loop")" = "1"    ]        || return 1
    [ "$(loop_ro             "$loop")" = "0"    ]        || return 1
}

find_image_loop() {
    current="$(mapper_status)"; old="$MAPPER_STATUS"; MAPPER_STATUS="$current"
    loop="$(mapper_loop_from_status)"; backing="$(mapper_backing_from_status)"
    if [ -n "$loop" ] && [ -b "$loop" ] && [ "$backing" = "$IMAGE_REAL" ]; then
        printf '%s\n' "$loop"; return 0
    fi
    for f in /sys/block/loop*/loop/backing_file; do
        [ -r "$f" ] || continue
        backing="$(cat "$f" 2>/dev/null)"
        image_path_match "$backing" || continue
        loop="/dev/block/$(basename "$(dirname "$(dirname "$f")")")"
        MAPPER_STATUS="$old"; printf '%s\n' "$loop"; return 0
    done
    MAPPER_STATUS="$old"; return 1
}

detach_image_loops() {
    found=0
    for f in /sys/block/loop*/loop/backing_file; do
        [ -r "$f" ] || continue
        backing="$(cat "$f" 2>/dev/null)"
        image_path_match "$backing" || continue
        loop="/dev/block/$(basename "$(dirname "$(dirname "$f")")")"
        found=1; log "Detaching loop: $loop"
        "$LOSETUP_BIN" -d "$loop" >/dev/null 2>&1 || true
    done
    for f in /sys/block/loop*/loop/backing_file; do
        [ -r "$f" ] || continue
        backing="$(cat "$f" 2>/dev/null)"
        image_path_match "$backing" || continue
        return 1
    done
    [ "$found" -eq 1 ] && debug "All image-backed loops detached"
    return 0
}

# ---------------------------------------------------------------------------
# USB / isodrive helpers
# ---------------------------------------------------------------------------

usb_connected() {
    for f in /sys/class/udc/*/state; do
        [ -r "$f" ] || continue
        s="$(cat "$f" 2>/dev/null)"
        case "$s" in attached|powered|default|addressed|configured|suspended) return 0;; esac
    done
    if [ -r /sys/class/android_usb/android0/state ]; then
        s="$(cat /sys/class/android_usb/android0/state 2>/dev/null)"
        case "$s" in CONFIGURED|CONNECTED|configured|connected) return 0;; esac
    fi
    return 1
}

isodrive_active() {
    [ -r /config/usb_gadget/g1/UDC ] || return 1
    [ -r /config/usb_gadget/g1/functions/mass_storage.0/lun.0/file ] || return 1
    udc="$( cat /config/usb_gadget/g1/UDC                                  2>/dev/null)"
    file="$(cat /config/usb_gadget/g1/functions/mass_storage.0/lun.0/file  2>/dev/null)"
    [ -n "$udc" ] && [ -n "$file" ]
}

isodrive_file()      { cat /config/usb_gadget/g1/functions/mass_storage.0/lun.0/file 2>/dev/null; }
isodrive_target_ok() { isodrive_active && [ "$(isodrive_file)" = "$IMAGE_USB" ]; }

stop_isodrive() {
    isodrive_active && { log "Stopping isodrive"; "$ISODRIVE_BIN" >/dev/null 2>&1 || true; }
    i=0; while isodrive_active && [ "$i" -lt 5 ]; do sleep 1; i=$((i+1)); done
    isodrive_active && return 1 || return 0
}

start_isodrive() {
    [ -f "$IMAGE_USB" ] || die "Image not accessible for isodrive: $IMAGE_USB"
    log "Starting isodrive RW: $IMAGE_USB"
    "$ISODRIVE_BIN" "$IMAGE_USB" -rw >/dev/null 2>&1 || die "isodrive failed"
    i=0; while ! isodrive_target_ok && [ "$i" -lt 5 ]; do sleep 1; i=$((i+1)); done
    isodrive_target_ok || die "isodrive did not become active with the expected image"
}

# ---------------------------------------------------------------------------
# Directories / bindfs
# ---------------------------------------------------------------------------

prepare_dirs() {
    log "Preparing mountpoints"
    mkdir -p "$REAL_MOUNT" "$USER_VIEW" || die "Could not create mountpoints"
    chown "0:${BIND_GID}" "$REAL_MOUNT" "$USER_VIEW" 2>/dev/null || true
    chmod 0775 "$REAL_MOUNT" "$USER_VIEW" 2>/dev/null || true
}

test_real_write() {
    log "Testing real filesystem write"
    testfile="$REAL_MOUNT/.imgdrive_write_test"
    rm -f "$testfile" 2>/dev/null || true
    touch "$testfile" 2>/dev/null && rm -f "$testfile" 2>/dev/null && \
        { log "Real write = PASSED"; return 0; }
    log "Real write = FAILED"; return 1
}

test_bindfs_write() {
    log "Testing bindfs write"
    testfile="$USER_VIEW/.imgdrive_bindfs_write_test"
    rm -f "$testfile" 2>/dev/null || true
    touch "$testfile" 2>/dev/null && rm -f "$testfile" 2>/dev/null && \
        { log "bindfs write = PASSED"; return 0; }
    log "bindfs write = FAILED"; return 1
}

bindfs_view_ok() {
    mi_bindfs_source_ok       "$USER_VIEW"   "$REAL_MOUNT" && return 0
    mi_bindfs_source_ok       "$PUBLIC_VIEW" "$REAL_MOUNT" && return 0
    mi_bindfs_source_ok_local "$USER_VIEW"   "$REAL_MOUNT" && return 0
    mi_bindfs_source_ok_local "$PUBLIC_VIEW" "$REAL_MOUNT" && return 0
    return 1
}

public_view_ok() {
    [ -d "$PUBLIC_VIEW" ] || return 1
    user_meta="$(  stat -c '%u:%g:%a:%F' "$USER_VIEW"   2>/dev/null)" || return 1
    public_meta="$(stat -c '%u:%g:%a:%F' "$PUBLIC_VIEW" 2>/dev/null)" || return 1
    [ "$user_meta" = "$public_meta" ]
}

wait_public_view() {
    i=0
    while [ "$i" -lt 15 ]; do
        refresh_mountinfo
        public_view_ok && { log "Public Android view = ACCESSIBLE"; return 0; }
        sleep 1; i=$((i+1))
    done
    log "Public Android view = FAILED"; return 1
}

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

cleanup_android_filesystem() {
    refresh_mountinfo
    log "===== CLEAN ANDROID FILESYSTEM ====="
    mounts="$(g_bind_mounts | sort -r)"
    for mp in $mounts; do
        [ -n "$mp" ] || continue
        log "Unmounting bindfs: $mp"
        g_umount    "$mp" >/dev/null 2>&1 ||
        g_umount -l "$mp" >/dev/null 2>&1 || true
    done
    for mp in "$USER_VIEW" "$PUBLIC_VIEW" \
              /mnt/androidwritable/0/emulated/0/"$(basename "$USER_VIEW")" \
              /mnt/installer/0/emulated/0/"$(basename "$USER_VIEW")" \
              /mnt/user/0/emulated/0/"$(basename "$USER_VIEW")" \
              /mnt/pass_through/0/emulated/0/"$(basename "$USER_VIEW")"; do
        g_umount "$mp" >/dev/null 2>&1 || true
    done
    refresh_mountinfo
    if g_real_f2fs_present; then
        log "Unmounting F2FS: $REAL_MOUNT"
        g_umount    "$REAL_MOUNT" >/dev/null 2>&1 || true
        refresh_mountinfo
        if g_real_f2fs_present; then
            log "Trying lazy unmount of F2FS"
            g_umount -l "$REAL_MOUNT" >/dev/null 2>&1 || true
            refresh_mountinfo
        fi
    fi
    if g_bindfs_present || mi_path_mounted "$USER_VIEW" || \
       mi_path_mounted "$PUBLIC_VIEW" || g_real_f2fs_present; then
        log "Android filesystem layer = DIRTY"; return 1
    fi
    log "Android filesystem layer = CLEAN"
}

close_mapper() {
    if mapper_active; then
        log "===== CLOSE LUKS ====="
        "$CRYPTSETUP_BIN" luksClose "$NAME" >/dev/null 2>&1 || true
        mapper_active && { log "LUKS mapper = DIRTY"; return 1; }
    fi
    log "LUKS mapper = CLEAN"
}

# ---------------------------------------------------------------------------
# State detection
# ---------------------------------------------------------------------------

refresh_state() {
    refresh_mountinfo
    MAPPER_STATUS="$(mapper_status)"
    ISO=0; MAPPER=0; REAL=0; BIND=0; PUBLIC=0
    LOOP_PRESENT=0; LOOP_OK=0; MAPPER_STACK_OK=0
    BIND_OK=0; PUBLIC_OK=0; ISO_OK=0
    STATE_REASON=""; LOOP=""

    isodrive_target_ok && { ISO=1; ISO_OK=1; } || isodrive_active && ISO=1
    { mapper_active || mapper_device_present; } && MAPPER=1

    if [ "$MAPPER" -eq 1 ]; then
        LOOP="$(mapper_loop_from_status)"
        backing="$(mapper_backing_from_status)"
        if mapper_status_consistent; then
            MAPPER_STACK_OK=1
        elif [ -b "/dev/mapper/$NAME" ] && [ -n "$LOOP" ] && [ -b "$LOOP" ] && [ "$backing" = "$IMAGE_REAL" ]; then
            MAPPER_STACK_OK=1
        fi
    else
        LOOP="$(find_image_loop 2>/dev/null)"
    fi

    if [ -n "$LOOP" ] && [ -b "$LOOP" ]; then
        LOOP_PRESENT=1; loop_config_ok "$LOOP" && LOOP_OK=1
    fi

    g_real_f2fs_present && REAL=1
    bindfs_view_ok      && BIND=1 && BIND_OK=1
    public_view_ok      && PUBLIC=1 && PUBLIC_OK=1

    if [ "$ISO" -eq 0 ] && [ "$MAPPER" -eq 1 ] && [ "$MAPPER_STACK_OK" -eq 1 ] && \
       [ "$LOOP_OK" -eq 1 ] && [ "$REAL" -eq 1 ] && [ "$BIND_OK" -eq 1 ] && [ "$PUBLIC_OK" -eq 1 ]; then
        STATE="STAGE1"; STATE_REASON="all Stage 1 invariants satisfied"
    elif [ "$ISO_OK" -eq 1 ] && [ "$MAPPER" -eq 0 ] && [ "$REAL" -eq 0 ] && \
         [ "$BIND" -eq 0 ] && [ "$LOOP_PRESENT" -eq 0 ]; then
        STATE="STAGE2"; STATE_REASON="isodrive exports the expected image and local stack is absent"
    else
        STATE="BROKEN"
        if   [ "$ISO" -eq 1 ] && [ "$ISO_OK" -eq 0 ]; then
            STATE_REASON="isodrive is active but exports an unexpected image"
        elif [ "$MAPPER" -eq 1 ] && [ "$MAPPER_STACK_OK" -eq 0 ]; then
            STATE_REASON="LUKS mapper is active but its loop/backing/mode/type is unexpected"
        elif [ "$LOOP_PRESENT" -eq 1 ] && [ "$LOOP_OK" -eq 0 ]; then
            STATE_REASON="image loop exists but is not 4096-byte DIO RW on the real image"
        elif [ "$REAL" -eq 0 ] && [ "$MAPPER" -eq 1 ]; then
            STATE_REASON="LUKS is active but the expected RW F2FS mount is missing"
        elif [ "$BIND_OK" -eq 0 ] && [ "$REAL" -eq 1 ]; then
            STATE_REASON="bindfs view is missing or has unexpected source/ownership/mode"
        elif [ "$PUBLIC_OK" -eq 0 ] && [ "$BIND" -eq 1 ]; then
            STATE_REASON="public Android view is missing or does not match bindfs view"
        elif [ "$MAPPER" -eq 0 ] && [ "$LOOP_PRESENT" -eq 1 ]; then
            STATE_REASON="image loop exists without the expected LUKS mapper"
        elif [ "$ISO_OK" -eq 1 ] && [ "$LOOP_PRESENT" -eq 1 ]; then
            STATE_REASON="isodrive is active while an image loop remains"
        else
            STATE_REASON="components do not match either complete Stage 1 or Stage 2"
        fi
    fi
}

status_command() {
    refresh_state
    log "===== STATUS ====="
    log "State       = $STATE"
    log "Reason      = $STATE_REASON"
    log "Config      = $CONF_FILE"
    log "Image       = $IMAGE_REAL"
    log "Loop        = ${LOOP:-NONE}"
    log "Mapper      = /dev/mapper/$NAME"
    log "Real mount  = $REAL_MOUNT"
    log "User view   = $USER_VIEW"
    log "Public view = $PUBLIC_VIEW"
    if [ "$ISO" -eq 1 ]; then
        log "ISOdrive    = ACTIVE"
        log "ISO image   = $(isodrive_file)"
    else
        log "ISOdrive    = CLEAN"
    fi
}

# ---------------------------------------------------------------------------
# Stage 1
# ---------------------------------------------------------------------------

start_stage1() {
    refresh_state
    log "===== ENSURE STAGE 1 ====="
    log "Image      = $IMAGE_REAL"
    log "Real mount = $REAL_MOUNT"
    log "User view  = $USER_VIEW"

    [ "$STATE" = "STAGE1" ] && { log "Stage 1 already intact — nothing to do"; return 0; }
    { [ "$STATE" = "STAGE2" ] || isodrive_active; } && { stop_isodrive || die "Could not stop isodrive"; }

    cleanup_android_filesystem || die "Could not clean Android filesystem layer"
    close_mapper               || die "Could not close existing LUKS mapper"
    detach_image_loops         || die "Could not detach stale image loop(s)"

    [ -f "$IMAGE_REAL" ] || die "Image not found: $IMAGE_REAL"
    [ -r "$KEYFILE" ]    || die "Keyfile not readable: $KEYFILE"

    prepare_dirs

    log "Creating loop (4096-byte sectors, DIO)"
    LOOP="$("$LOSETUP_BIN" -f --show --sector-size 4096 --direct-io=on "$IMAGE_REAL" 2>/dev/null)" || die "losetup failed"
    [ -n "$LOOP" ] || die "losetup returned no loop device"
    log "Loop = $LOOP"
    loop_config_ok "$LOOP" || { "$LOSETUP_BIN" -d "$LOOP" >/dev/null 2>&1 || true; die "Loop config not 4096-byte + DIO + RW"; }

    log "Checking LUKS header"
    "$CRYPTSETUP_BIN" isLuks "$LOOP" >/dev/null 2>&1 || { "$LOSETUP_BIN" -d "$LOOP" >/dev/null 2>&1 || true; die "Invalid LUKS header"; }

    log "Opening LUKS mapper: $NAME"
    "$CRYPTSETUP_BIN" luksOpen "$LOOP" "$NAME" --key-file "$KEYFILE" >/dev/null 2>&1 || true
    mapper_active || { "$LOSETUP_BIN" -d "$LOOP" >/dev/null 2>&1 || true; die "LUKS mapper failed to become active"; }
    log "LUKS mapper = ACTIVE"

    fs_type="$(/system/bin/blkid -o value -s TYPE "/dev/mapper/$NAME" 2>/dev/null)"
    [ "$fs_type" = "f2fs" ] || die "Inner filesystem is not F2FS (detected: ${fs_type:-unknown})"
    log "Inner filesystem = F2FS"

    log "Mounting F2FS RW: $REAL_MOUNT"
    g_mount -t f2fs -o rw "/dev/mapper/$NAME" "$REAL_MOUNT" >/dev/null 2>&1 || die "F2FS mount failed"
    refresh_mountinfo
    g_real_f2fs_present || die "F2FS mount not visible after mounting"
    log "F2FS = RW"
    test_real_write || die "Real F2FS write test failed"

    log "Mounting bindfs: $REAL_MOUNT -> $USER_VIEW (${BIND_UID}:${BIND_GID} / $BIND_PERMS)"
    "$NSENTER_BIN" -t 1 -m -- env PATH="$PATH" LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}" \
        "$BINDFS_BIN" -u "$BIND_UID" -g "$BIND_GID" --perms="$BIND_PERMS" \
        --create-with-perms=g+s "$REAL_MOUNT" "$USER_VIEW" >/dev/null 2>&1 || die "bindfs mount failed"
    refresh_mountinfo
    bindfs_view_ok || die "bindfs view did not match expected config"
    log "bindfs = ACTIVE"
    test_bindfs_write || die "bindfs write test failed"

    wait_public_view || die "Android public view did not appear"
    refresh_state
    [ "$STATE" = "STAGE1" ] || die "Stage 1 verification failed: $STATE ($STATE_REASON)"
    log "===== STAGE 1 READY ====="
    log "Loop   = $LOOP"
    log "Mapper = /dev/mapper/$NAME"
    log "Mount  = $REAL_MOUNT"
    log "View   = $USER_VIEW"
}

# ---------------------------------------------------------------------------
# Stage 2
# ---------------------------------------------------------------------------

start_stage2() {
    refresh_state
    log "===== ENSURE STAGE 2 ====="
    if ! usb_connected; then log "USB not connected — Stage 2 cannot start"; return 1; fi
    [ "$STATE" = "STAGE2" ] && { log "Stage 2 already intact — nothing to do"; return 0; }
    isodrive_active && { stop_isodrive || true; }
    cleanup_android_filesystem || die "Could not clean Android filesystem layer"
    close_mapper               || die "Could not close existing LUKS mapper"
    detach_image_loops         || die "Could not detach stale image loop(s)"
    sync; start_isodrive
    refresh_state
    [ "$STATE" = "STAGE2" ] || die "Stage 2 verification failed: $STATE ($STATE_REASON)"
    log "===== STAGE 2 READY ====="; log "Image = $IMAGE_USB"
}

# ---------------------------------------------------------------------------
# Full shutdown
# ---------------------------------------------------------------------------

stop_everything() {
    log "===== STOP EVERYTHING ====="
    stop_isodrive              || die "Could not stop isodrive"
    cleanup_android_filesystem || die "Could not clean Android filesystem layer"
    close_mapper               || die "Could not close LUKS mapper"
    detach_image_loops         || die "Could not detach image loop(s)"
    refresh_mountinfo
    if ! isodrive_active && ! mapper_active && ! g_real_f2fs_present && \
       ! g_bindfs_present && [ -z "$(find_image_loop 2>/dev/null)" ]; then
        log "Everything = CLEAN"; return 0
    fi
    log "Everything = DIRTY"; return 1
}

# ---------------------------------------------------------------------------
# Command dispatch
# ---------------------------------------------------------------------------

cmd_toggle() {
    refresh_state
    case "$STATE" in
        STAGE1) start_stage2 ;;
        STAGE2) start_stage1 ;;
        BROKEN) usb_connected && start_stage2 || start_stage1 ;;
    esac
}

cmd_sync() { usb_connected && start_stage2 || start_stage1; }

# ---------------------------------------------------------------------------
# setup — provision a new encrypted drive
# ---------------------------------------------------------------------------
cmd_setup() {
    SETUP_LOCK="/data/adb/imgdrive/setup.lock"
    if [ -f "$SETUP_LOCK" ]; then
        die "Setup already running (lock: $SETUP_LOCK). If stale, remove it manually."
    fi
    touch "$SETUP_LOCK" || die "Cannot create lock file: $SETUP_LOCK"
    trap 'rm -f "$SETUP_LOCK"' EXIT INT TERM

    size="$SETUP_SIZE"
    # Validate size format: number + optional G/M suffix
    case "$size" in
        [0-9]*[Gg]) unit=G; num="${size%[Gg]}" ;;
        [0-9]*[Mm]) unit=M; num="${size%[Mm]}" ;;
        [0-9]*)     unit=G; num="$size" ;;
        *) die "Invalid size '$size'. Use e.g. 10G or 500M" ;;
    esac
    [ "$num" -gt 0 ] 2>/dev/null || die "Size must be a positive number"

    log "===== SETUP: $num${unit}B encrypted drive ====="
    log "Image  : $IMAGE_REAL"
    log "Keyfile: $KEYFILE"
    log "Mapper : $NAME"

    # Step 1: keyfile
    kf_dir="$(dirname "$KEYFILE")"
    if [ ! -f "$KEYFILE" ]; then
        log "Generating keyfile: $KEYFILE"
        mkdir -p "$kf_dir" || die "Cannot create keyfile dir: $kf_dir"
        dd if=/dev/urandom of="$KEYFILE" bs=64 count=1 2>/dev/null || die "keyfile generation failed"
        chmod 600 "$KEYFILE"
        log "Keyfile created"
    else
        log "Keyfile exists — reusing"
    fi

    # Step 2: allocate image
    img_dir="$(dirname "$IMAGE_REAL")"
    mkdir -p "$img_dir" || die "Cannot create image dir: $img_dir"
    if [ -f "$IMAGE_REAL" ]; then
        log "Image already exists — skipping allocation (delete it first to reprovision)"
    else
        log "Allocating ${num}${unit}B image…"
        fallocate -l "${num}${unit}" "$IMAGE_REAL" 2>/dev/null || \
            truncate -s "${num}${unit}" "$IMAGE_REAL" || \
            die "Image allocation failed"
        log "Image allocated: $(ls -lh "$IMAGE_REAL" | awk '{print $5}')"
    fi

    # Step 3: LUKS2 format
    log "Formatting LUKS2…"
    "$CRYPTSETUP_BIN" luksFormat \
        --type luks2 --cipher aes-xts-plain64 --key-size 512 \
        --hash sha512 --pbkdf argon2id --sector-size 4096 \
        --batch-mode --key-file "$KEYFILE" \
        "$IMAGE_REAL" || die "luksFormat failed"
    log "LUKS2 header written"

    # Step 4: open
    SETUP_NAME="${NAME}_setup"
    log "Opening mapper: $SETUP_NAME"
    "$CRYPTSETUP_BIN" luksOpen "$IMAGE_REAL" "$SETUP_NAME" \
        --key-file "$KEYFILE" || die "luksOpen failed"

    # Step 5: mkfs.f2fs
    log "Formatting F2FS…"
    if ! mkfs.f2fs -f "/dev/mapper/$SETUP_NAME" >/dev/null 2>&1; then
        "$CRYPTSETUP_BIN" luksClose "$SETUP_NAME" 2>/dev/null || true
        die "mkfs.f2fs failed — is f2fs-tools installed? (pkg install f2fs-tools)"
    fi
    log "F2FS formatted"

    # Step 6: close
    "$CRYPTSETUP_BIN" luksClose "$SETUP_NAME" || die "luksClose failed"
    log "===== SETUP COMPLETE — run: imgdrive-ctl mount ====="
}

# ---------------------------------------------------------------------------
# keys — LUKS slot management
# ---------------------------------------------------------------------------
cmd_keys() {
    [ -f "$IMAGE_REAL" ] || die "Image not found: $IMAGE_REAL"
    [ -r "$KEYFILE" ]    || die "Keyfile not readable: $KEYFILE"

    case "$KEYS_CMD" in
        list)
            log "===== LUKS KEY SLOTS: $IMAGE_REAL ====="
            "$CRYPTSETUP_BIN" luksDump "$IMAGE_REAL" 2>&1 | \
                awk '/^Keyslots:/,0' | grep -E '^\s+[0-9]+:|Priority:|PBKDF:|^\s+Key:'
            active="$("$CRYPTSETUP_BIN" luksDump "$IMAGE_REAL" 2>/dev/null | \
                awk '/^Keyslots:/{k=1;next} k && /^\s+[0-9]+:/{n++} END{print n+0}')"
            log "Active slots: $active"
            [ "$active" -lt 2 ] && log "WARNING: only 1 slot — add a passphrase backup with: imgdrive-ctl keys add-pass"
            ;;
        add-pass)
            printf 'Enter new passphrase: '
            stty -echo 2>/dev/null; read -r passphrase; stty echo 2>/dev/null; printf '\n'
            [ -n "$passphrase" ] || die "Empty passphrase"
            printf '%s' "$passphrase" | \
                "$CRYPTSETUP_BIN" luksAddKey --key-file "$KEYFILE" \
                "$IMAGE_REAL" --new-keyfile-fd 0 || die "luksAddKey failed"
            log "Passphrase slot added"
            ;;
        add-key)
            newkf="$KEYS_ARG"
            if [ ! -f "$newkf" ]; then
                log "Generating new keyfile: $newkf"
                mkdir -p "$(dirname "$newkf")"
                dd if=/dev/urandom of="$newkf" bs=64 count=1 2>/dev/null || die "keyfile generation failed"
                chmod 600 "$newkf"
                log "New keyfile generated"
            fi
            "$CRYPTSETUP_BIN" luksAddKey --key-file "$KEYFILE" \
                "$IMAGE_REAL" "$newkf" || die "luksAddKey failed"
            log "Keyfile slot added: $newkf"
            ;;
        remove)
            slot="$KEYS_ARG"
            printf '%s' "$slot" | grep -qE '^[0-9]+$' || die "Slot must be a number"
            "$CRYPTSETUP_BIN" luksKillSlot --key-file "$KEYFILE" \
                "$IMAGE_REAL" "$slot" || die "luksKillSlot failed"
            log "Slot $slot removed"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# drives — multi-drive config management
# ---------------------------------------------------------------------------
CONFD="/sdcard/Documents/imgdrive/conf.d"
WRITE_CONF_BIN="/data/adb/imgdrive/bin/write-default-conf"
PRIMARY_CONF_PATH="/sdcard/Documents/imgdrive/imgdrive.conf"

cmd_drives() {
    case "$DRIVES_CMD" in
        list)
            log "===== DRIVES ====="
            log "primary: $PRIMARY_CONF_PATH"
            for f in "$CONFD"/*.conf; do
                [ -f "$f" ] || continue
                log "  extra: $f"
            done
            ;;
        add)
            name="$DRIVES_ARG"
            printf '%s' "$name" | grep -qE '^[a-zA-Z0-9_-]+$' || \
                die "Drive name must be alphanumeric (a-z, 0-9, _, -)"
            dest="$CONFD/${name}.conf"
            [ -f "$dest" ] && die "Drive conf already exists: $dest"
            mkdir -p "$CONFD"
            if [ -x "$WRITE_CONF_BIN" ]; then
                "$WRITE_CONF_BIN" "$dest" || die "write-default-conf failed"
            else
                die "write-default-conf not found at $WRITE_CONF_BIN"
            fi
            log "Drive created: $dest"
            log "Edit IMAGE_REAL/KEYFILE/NAME in $dest then run: imgdrive-ctl -c $dest setup 10G"
            ;;
        remove)
            name="$DRIVES_ARG"
            target="$CONFD/${name}.conf"
            [ -f "$target" ] || die "Drive not found: $target"
            rm -f "$target" && log "Removed: $target" || die "Failed to remove $target"
            ;;
    esac
}

case "$COMMAND" in
    mount)  start_stage1 ;;
    usb)    start_stage2 ;;
    toggle) cmd_toggle   ;;
    sync)   cmd_sync     ;;
    status) status_command ;;
    off)    stop_everything ;;
    setup)  cmd_setup ;;
    keys)   cmd_keys ;;
    drives) cmd_drives ;;
    *) die "Unknown command: $COMMAND" ;;
esac
